DB_PATH=data/ww3.db
WW3_STREAM_PATH=data/stream/events.jsonl
# Collection never uses a model. Explicit analysis additionally requires this
# fail-closed switch to be set to 0, false, no, or off.
WW3_DISABLE_LLM=1
BRAVE_SEARCH_API_KEY=
# Optional: sibling ../rhetorlint-spec is discovered automatically. This trusted
# local code executes with your user privileges; the bridge is not a sandbox.
RHETORLINT_ROOT=
# Optional trusted Node executable name/path; defaults to node from PATH and is
# likewise not restricted from filesystem, process, or network access.
RHETORLINT_NODE=
# Optional comma-separated rule ids to withhold. Defaults to shouting.caps,
# whose ALL-CAPS tell fires on the house typography of wire and institutional
# copy. Withheld rules are always named in the output; set to an empty value to
# apply the whole pack.
RHETORLINT_EXCLUDED_RULES=
