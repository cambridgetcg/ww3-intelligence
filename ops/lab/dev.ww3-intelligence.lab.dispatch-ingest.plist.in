<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Every 30 minutes the lab Mac asks GitHub for one ingest run, unless one is
  queued, running or under 20 minutes old (ops/ARCHIVE.md). The */30 cron in
  ww3-ingest.yml stays as the fallback. ops/lab/install.sh fills the @@...@@
  placeholders; do not load this template as it stands.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.ww3-intelligence.lab.dispatch-ingest</string>
  <key>ProgramArguments</key>
  <array>
    <string>@@PYTHON@@</string>
    <string>-I</string>
    <string>@@LIBEXEC@@/lab_archive.py</string>
    <string>dispatch-ingest</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>HOME</key>
    <string>@@HOME@@</string>
    <key>WW3_ARCHIVE_ROOT</key>
    <string>@@ARCHIVE_ROOT@@</string>
    <key>WW3_GH</key>
    <string>@@GH@@</string>
    <key>WW3_GPG</key>
    <string>@@GPG@@</string>
    <key>WW3_REPO</key>
    <string>@@REPO@@</string>
  </dict>
  <key>StartInterval</key>
  <integer>1800</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>@@ARCHIVE_ROOT@@/logs/dispatch-ingest.out.log</string>
  <key>StandardErrorPath</key>
  <string>@@ARCHIVE_ROOT@@/logs/dispatch-ingest.err.log</string>
</dict>
</plist>
